[Unit]
Description=habit-idle
After=network.target

[Service]
Type=simple
User=nathan
Environment=HABIT_IDLE_DB=/home/nathan/data/habit-idle/habit-idle.db
Environment=HOST=127.0.0.1
Environment=PORT=3002
ExecStart=/home/nathan/apps/habit-idle/habit-idle
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/home/nathan/data/habit-idle
PrivateTmp=true

[Install]
WantedBy=multi-user.target
